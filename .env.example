EVO_API_URL=http://evolution_api:8080
EVO_API_KEY=troque-esta-chave

POSTGRES_USER=continnumos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=continnumos
DATABASE_URL=postgresql://continnumos:troque-esta-senha@postgres_db:5432/continnumos

REDIS_URL=redis://redis:6379/0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-admin
ADMIN_PHONE=5542999999999@s.whatsapp.net

JWT_SECRET=troque-este-segredo-jwt
JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=86400
ENFORCE_SINGLE_SESSION=false
COOKIE_SECURE=true
MAX_MEDIA_UPLOAD_MB=32
WEBHOOK_SECRET=troque-este-segredo-webhook
ALLOWED_ORIGINS=https://painel.continnumos.shop,http://localhost:8000

# --- Fase 4: super-admin (gestão de clientes) ---
# Deixe vazio para desabilitar o painel /superadmin.
SUPER_ADMIN_TOKEN=

# --- Fase 5: storage de mídia ---
# local (padrão) grava em disco; s3 usa bucket S3/R2 compatível.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Fase 5: observabilidade e backups ---
LOG_JSON=false
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
BACKUP_DIR=/data/backups

# --- Fase 6: gestão/rotação de segredos ---
# Em produção, prefira segredos como ARQUIVOS (Docker/K8s secrets) em vez de env plano.
# Precedência por segredo: {NOME}_FILE > SECRETS_DIR/{NOME} > variável de ambiente.
# Ex.: JWT_SECRET_FILE=/run/secrets/jwt_secret  OU  SECRETS_DIR=/run/secrets
SECRETS_DIR=

# --- Fase 6: migrations versionadas (Alembic) ---
# Em produção com Alembic: RUN_DB_MIGRATIONS_ON_BOOT=false e rode `alembic upgrade head`.
RUN_DB_MIGRATIONS_ON_BOOT=true

# --- Fase 6: pagamento real (gateway + webhook) ---
# PAYMENT_PROVIDER: manual | stripe | mercadopago | asaas
PAYMENT_PROVIDER=manual
# Segredo de assinatura do webhook do gateway (verifica autenticidade).
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-do-webhook-de-pagamento
# Reativa automaticamente o tenant quando a fatura é paga via webhook.
BILLING_REACTIVATE_ON_PAYMENT=true

# --- Fase 6: suspensão automática por inadimplência ---
BILLING_ENFORCEMENT_ENABLED=true
BILLING_GRACE_DAYS=5

# --- Fase 6: rate limiting por tenant/IP ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_WEBHOOK_MAX=1200

# --- Fase 7: múltiplos workers/réplicas ---
# Nº de workers do uvicorn ao rodar 'python main.py'.
WEB_CONCURRENCY=1
# Loops periódicos (SLA, follow-up, lembretes, limpeza). Em deploy com N réplicas
# web, deixe true SOMENTE em uma (ou num scheduler dedicado) e false nas demais.
RUN_BACKGROUND_JOBS=true

# --- Fase 7: fila de jobs (webhooks/mídia pesada) ---
# true = enfileira no Redis (consumido por 'python worker.py'); false = inline.
JOB_QUEUE_ENABLED=false
JOB_QUEUE_KEY=jobq:default
JOB_QUEUE_BLOCK_SECONDS=5

# --- Fase 7: métricas Prometheus + tracing ---
METRICS_ENABLED=true
# Se definido, /metrics exige Authorization: Bearer <token>.
METRICS_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=continnumos
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Fase 7: alertas (Sentry) ---
# Deixe vazio para desativar. Aceita SENTRY_DSN_FILE / secret manager (Fase 6).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Fase 8: signup self-service + trial ---
# Habilita a pagina publica /signup e a criacao de conta self-service.
SIGNUP_ENABLED=true
# Plano inicial e duracao do trial (dias) para novas contas.
SIGNUP_DEFAULT_PLAN=free
TRIAL_DAYS=14
# Dominio base para montar a URL do tenant (slug.BASE_DOMAIN). Ex: app.seudominio.com
# Requer DNS wildcard (*.BASE_DOMAIN) apontando para a aplicacao.
BASE_DOMAIN=

# --- Fase 8: auditoria / LGPD ---
# Retencao de mensagens (dias). 0 desativa a limpeza automatica.
DATA_RETENTION_DAYS=0
# Contato do encarregado (DPO) exibido para exercicio de direitos.
DPO_CONTACT_EMAIL=

# --- Fase 9: diferenciais (API publica, webhooks, white-label) ---
# Nao requer novas variaveis obrigatorias: API keys, webhooks de saida e
# branding sao gerenciados por tenant via API/portal. BASE_DOMAIN (Fase 8) e
# reutilizado para subdominios; dominios proprios sao definidos por tenant.
# Opcional: rota /api/v1/* respeita o rate limiting da Fase 6 (RATE_LIMIT_*).

VENDAS_1=Vendas 1
VENDAS_2=Vendas 2
FINANCEIRO=Financeiro
ENGENHARIA=Engenharia

BOT_MEM_LIMIT=768m
BOT_MEM_RESERVATION=384m
BOT_MEMSWAP_LIMIT=768m
POSTGRES_MEM_LIMIT=768m
POSTGRES_MEM_RESERVATION=384m
POSTGRES_MEMSWAP_LIMIT=768m
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=128m
REDIS_MEMSWAP_LIMIT=256m
EVOLUTION_API_MEM_LIMIT=1024m
EVOLUTION_API_MEM_RESERVATION=512m
EVOLUTION_API_MEMSWAP_LIMIT=1024m
