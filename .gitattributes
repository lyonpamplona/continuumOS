# continnumOS - normalizacao de encoding e fim de linha
# Evita reintroducao de mojibake / quebras ao subir para o GitHub em Windows.
* text=auto eol=lf

*.py          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.toml        text eol=lf
*.txt         text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.webmanifest text eol=lf
.env*         text eol=lf
Dockerfile    text eol=lf

# Binarios - nunca normalizar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.ogg   binary
*.wav   binary
